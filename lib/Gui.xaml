<!--
  Layout for the gui command. Loaded as a file by Show-SusGui (lib\Gui.ps1). Scan data is never
  put into this markup: the code only sets Text and ItemsSource on the named elements.
  Colours are DynamicResource brushes that Show-SusGui fills from the Windows light/dark setting.
-->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SusHunt" Width="1100" Height="720" MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource FgBrush}"
        FontFamily="Segoe UI" FontSize="13">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="12,4"/>
      <Setter Property="Margin" Value="0,0,6,0"/>
      <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource FgBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
    </Style>
    <Style TargetType="ToggleButton">
      <Setter Property="Padding" Value="12,4"/>
      <Setter Property="Margin" Value="0,0,6,0"/>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource FgBrush}"/>
      <Setter Property="Margin" Value="10,0,0,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource FgBrush}"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource FgBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
      <Setter Property="Padding" Value="3,2"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
  </Window.Resources>

  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="2*"/>
      <RowDefinition Height="5"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Scan picker and admin badge -->
    <DockPanel Grid.Row="0" Margin="0,0,0,8">
      <TextBlock x:Name="AdminBadge" DockPanel.Dock="Right" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="360"/>
      <StackPanel x:Name="ScanButtons" Orientation="Horizontal">
        <RadioButton x:Name="ScanTriage" GroupName="Scan" Style="{StaticResource {x:Type ToggleButton}}" Content="Triage" IsChecked="True"/>
        <RadioButton x:Name="ScanFiles" GroupName="Scan" Style="{StaticResource {x:Type ToggleButton}}" Content="Files"/>
        <RadioButton x:Name="ScanAutoruns" GroupName="Scan" Style="{StaticResource {x:Type ToggleButton}}" Content="Autoruns"/>
        <RadioButton x:Name="ScanConnections" GroupName="Scan" Style="{StaticResource {x:Type ToggleButton}}" Content="Connections"/>
        <RadioButton x:Name="ScanBaseline" GroupName="Scan" Style="{StaticResource {x:Type ToggleButton}}" Content="Baseline"/>
        <RadioButton x:Name="ScanDiff" GroupName="Scan" Style="{StaticResource {x:Type ToggleButton}}" Content="Diff"/>
      </StackPanel>
    </DockPanel>

    <!-- Options: only the ones the selected scan uses are visible -->
    <WrapPanel Grid.Row="1" Margin="0,0,0,8">
      <TextBlock x:Name="ScanHelp" VerticalAlignment="Center" Margin="0,0,16,0" Foreground="{DynamicResource MutedBrush}"/>
      <StackPanel x:Name="OptMinScore" Orientation="Horizontal" Margin="0,0,16,0">
        <TextBlock Text="Min score " VerticalAlignment="Center"/>
        <TextBox x:Name="MinScoreBox" Width="44"/>
      </StackPanel>
      <StackPanel x:Name="OptDays" Orientation="Horizontal" Margin="0,0,16,0">
        <TextBlock Text="Days " VerticalAlignment="Center"/>
        <TextBox x:Name="DaysBox" Width="44" Text="7"/>
      </StackPanel>
      <StackPanel x:Name="OptPath" Orientation="Horizontal">
        <TextBlock Text="Extra folder " VerticalAlignment="Center"/>
        <TextBox x:Name="PathBox" Width="280"/>
        <Button x:Name="BrowseButton" Content="..." Margin="4,0,0,0" Padding="8,2"/>
      </StackPanel>
    </WrapPanel>

    <!-- Run / Cancel / status -->
    <DockPanel Grid.Row="2" Margin="0,0,0,8">
      <Button x:Name="RunButton" Content="Run" IsDefault="True" FontWeight="SemiBold"/>
      <Button x:Name="CancelButton" Content="Cancel" IsEnabled="False"/>
      <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="8,0,0,0" TextTrimming="CharacterEllipsis" Text="Pick a scan and press Run."/>
    </DockPanel>

    <!-- Filter -->
    <DockPanel Grid.Row="3" Margin="0,0,0,6">
      <TextBlock Text="Filter " VerticalAlignment="Center"/>
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <CheckBox x:Name="SevHigh" Content="High" IsChecked="True"/>
        <CheckBox x:Name="SevMedium" Content="Medium" IsChecked="True"/>
        <CheckBox x:Name="SevLow" Content="Low" IsChecked="True"/>
        <CheckBox x:Name="SevInfo" Content="Info" IsChecked="False"/>
        <TextBlock x:Name="CountText" VerticalAlignment="Center" Margin="14,0,0,0" Foreground="{DynamicResource MutedBrush}"/>
      </StackPanel>
      <TextBox x:Name="FilterBox" ToolTip="Matches Name, Path and Summary"/>
    </DockPanel>

    <!-- Results -->
    <DataGrid Grid.Row="4" x:Name="Grid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
              CanUserSortColumns="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
              Background="{DynamicResource BgBrush}" RowBackground="{DynamicResource PanelBrush}"
              Foreground="{DynamicResource FgBrush}" BorderBrush="{DynamicResource LineBrush}"
              HorizontalGridLinesBrush="{DynamicResource LineBrush}">
      <DataGrid.ColumnHeaderStyle>
        <Style TargetType="DataGridColumnHeader">
          <Setter Property="Background" Value="{DynamicResource BgBrush}"/>
          <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
          <Setter Property="Padding" Value="6,4"/>
          <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
          <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>
      </DataGrid.ColumnHeaderStyle>
      <DataGrid.RowStyle>
        <Style TargetType="DataGridRow">
          <Setter Property="Foreground" Value="{DynamicResource FgBrush}"/>
          <Style.Triggers>
            <DataTrigger Binding="{Binding Severity}" Value="High"><Setter Property="Foreground" Value="{DynamicResource HighBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger>
            <DataTrigger Binding="{Binding Severity}" Value="Medium"><Setter Property="Foreground" Value="{DynamicResource MediumBrush}"/></DataTrigger>
            <DataTrigger Binding="{Binding Severity}" Value="Low"><Setter Property="Foreground" Value="{DynamicResource LowBrush}"/></DataTrigger>
            <DataTrigger Binding="{Binding Severity}" Value="Info"><Setter Property="Foreground" Value="{DynamicResource InfoBrush}"/></DataTrigger>
            <DataTrigger Binding="{Binding Severity}" Value="Added"><Setter Property="Foreground" Value="{DynamicResource AddedBrush}"/></DataTrigger>
            <DataTrigger Binding="{Binding Severity}" Value="Changed"><Setter Property="Foreground" Value="{DynamicResource MediumBrush}"/></DataTrigger>
            <DataTrigger Binding="{Binding Severity}" Value="Removed"><Setter Property="Foreground" Value="{DynamicResource RemovedBrush}"/></DataTrigger>
          </Style.Triggers>
        </Style>
      </DataGrid.RowStyle>
      <DataGrid.Columns>
        <DataGridTextColumn Header="Score" Binding="{Binding Score}" Width="60"/>
        <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="80"/>
        <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="110"/>
        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="220"/>
        <DataGridTextColumn Header="Summary" Binding="{Binding Summary}" Width="*"/>
        <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="*"/>
      </DataGrid.Columns>
    </DataGrid>

    <GridSplitter Grid.Row="5" HorizontalAlignment="Stretch" Background="{DynamicResource LineBrush}"/>

    <!-- Detail of the selected row -->
    <Border Grid.Row="6" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Background="{DynamicResource PanelBrush}" Margin="0,4,0,8">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <TextBlock x:Name="DetailText" TextWrapping="Wrap" Margin="10,8" FontFamily="Consolas" FontSize="12.5"/>
      </ScrollViewer>
    </Border>

    <!-- Row actions -->
    <StackPanel Grid.Row="7" Orientation="Horizontal">
      <Button x:Name="CopyHashButton" Content="Copy SHA-256" IsEnabled="False"/>
      <Button x:Name="OpenFolderButton" Content="Open folder" IsEnabled="False" ToolTip="Shows the file selected in Explorer. Never opens or runs it."/>
      <Button x:Name="AllowButton" Content="Add to allowlist" IsEnabled="False"/>
      <Button x:Name="SaveHtmlButton" Content="Save HTML report" IsEnabled="False"/>
    </StackPanel>
  </Grid>
</Window>
